{
  "id": "tecnaitem",
  "name": "TECNAI 电镜（<放大倍数>X-<标记>-<序号>）",
  "source": "stem",
  "regex": "^(?<magnification>\\d+)X-(?<marker>.+)-(?<index>\\d+)$",
  "types": {
    "magnification": "number",
    "index": "number",
    "width": "number",
    "height": "number",
    "size": "number",
    "date": "date",
    "btime": "date"
  },
  "ask": ["sample"],
  "onMismatch": "empty",
  "frontmatter": {
    "tags": ["annex-gallery-metadata", "{{tags}}"],
    "sample": "{{sample}}",
    "session": "{{session}}",
    "date": "{{date}}",
    "magnification": "{{magnification}}",
    "index": "{{index}}",
    "width": "{{width}}",
    "height": "{{height}}",
    "size": "{{size}}",
    "btime": "{{btime}}",
    "thumbnail": "{{thumbnail}}",
    "tif": "{{tif}}"
  },
  "template": "AnnexGalleryTemplates/tecnaitem.md"
}
