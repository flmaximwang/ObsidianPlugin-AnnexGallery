# Annex Gallery built-in gallery template: a card view showing only the file name + thumbnail.
# Available placeholders (wrapped in double braces): folder (the gallery folder) · cardSize (= thumbnail edge from Settings) · properties (metadata keys found).
# Top-level filters are generated by the plugin: file.inFolder(<folder>) and file.hasTag("annex-gallery-metadata");
# Filters written in the template are merged in and can only narrow, never widen.
views:
  - type: cards
    name: Gallery
    order:
      - file.name
    sort:
      - property: file.name
        direction: ASC
    image: note.thumbnail
    imageAspectRatio: 1
    imageFit: contain
    cardSize: {{cardSize}}
