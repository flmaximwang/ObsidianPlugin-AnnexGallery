# ============================================================
# 4) Kept last -> highest priority (overrides every match above)
# ============================================================

# Obsidian configuration directory: small text + Obsidian writes into it
#   -> straight into git; must never become an annex symlink or settings cannot be saved
.obsidian/**       annex.largefiles=nothing

# Thumbnails: plugin-generated <stem>.thumbnail.png must go into git with the gallery,
#   and must override the *.png annex rule above (the gallery still works after the original is dropped)
*.thumbnail.png    annex.largefiles=nothing

# Obsidian document bodies: small text, into git
*.md               annex.largefiles=nothing
*.base             annex.largefiles=nothing
*.canvas           annex.largefiles=nothing
