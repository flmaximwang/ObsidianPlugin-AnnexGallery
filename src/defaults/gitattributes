# ============================================================
# git-annex 分流规则（annex.largefiles）
#   进 annex   = 内容存进 .git/annex/objects，git 历史里只留链接 → 历史不膨胀
#   不进 annex = 内容直接进 git 历史（适合小文本、需要随时可写的文件）
#   同一条路径被多条 pattern 匹配时：**本文件里靠后的那条赢**
#   ⇒ 第 0 节是兜底默认，后面每一条都比它更具体、都能盖住它。
#   dotfile（.xxx）与 dotdir 里的文件不走这套：它们默认直接进 git。
# ============================================================

# ------------------------------------------------------------
# 0) 兜底默认：没被下面任何一条点名过的文件 → 进 annex
#    （「保存下来，但不占 git 历史」）
# ------------------------------------------------------------
*                  annex.largefiles=anything

# ------------------------------------------------------------
# 1) 常见媒体格式 → 进 annex
#   图片例外：文件名形如 xxx.important.<suffix> 的不进 annex（留作普通 git 文件）
#   注意：gitattributes 的 pattern 在 macOS 上不区分大小写（E.PNG 也匹配 *.png），
#         但 git-annex 的 glob 区分大小写 ⇒ 只有小写 .important. 会被排除；
#         .IMPORTANT. / .Important. 仍会进 annex。
# ------------------------------------------------------------
# 图片
*.png              annex.largefiles=exclude=*.important.*
*.jpg              annex.largefiles=exclude=*.important.*
*.jpeg             annex.largefiles=exclude=*.important.*
*.gif              annex.largefiles=exclude=*.important.*
*.bmp              annex.largefiles=exclude=*.important.*
*.tif              annex.largefiles=exclude=*.important.*
*.tiff             annex.largefiles=exclude=*.important.*
*.webp             annex.largefiles=exclude=*.important.*
*.avif             annex.largefiles=exclude=*.important.*
*.heic             annex.largefiles=exclude=*.important.*
*.svg              annex.largefiles=exclude=*.important.*
*.ico              annex.largefiles=exclude=*.important.*
# 音视频
*.mp4              annex.largefiles=anything
*.mov              annex.largefiles=anything
*.webm             annex.largefiles=anything
*.avi              annex.largefiles=anything

