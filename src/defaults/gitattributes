# ============================================================
# git-annex routing rules (annex.largefiles)
#   into annex   = content stored in .git/annex/objects, only a link in git history -> history stays small
#   not in annex = content goes straight into git history (good for small text files that must stay writable)
#   when several patterns match one path: **the later one in this file wins**
#   => section 0 is the fallback default; every later rule is more specific and overrides it.
#   dotfiles (.xxx) and files in dotdirs do not use these rules: they go straight into git.
# ============================================================

# ------------------------------------------------------------
# 0) Fallback default: files not named by any rule below -> into annex
#    ("saved, but without using up git history")
# ------------------------------------------------------------
*                  annex.largefiles=anything

# ------------------------------------------------------------
# 1) Common media formats -> into annex
#   Image exception: names like xxx.important.<suffix> do not enter annex (kept as ordinary git files)
#   Note: gitattributes patterns are case-insensitive on macOS (E.PNG also matches *.png),
#        but git-annex globs are case-sensitive => only lowercase .important. is excluded;
#        .IMPORTANT. / .Important. still enter annex.
# ------------------------------------------------------------
# Images
*.png              annex.largefiles=exclude=*.important.*
*.jpg              annex.largefiles=exclude=*.important.*
*.jpeg             annex.largefiles=exclude=*.important.*
*.gif              annex.largefiles=exclude=*.important.*
*.bmp              annex.largefiles=exclude=*.important.*
*.tif              annex.largefiles=exclude=*.important.*
*.tiff             annex.largefiles=exclude=*.important.*
*.webp             annex.largefiles=exclude=*.important.*
*.avif             annex.largefiles=exclude=*.important.*
*.heic             annex.largefiles=exclude=*.important.*
*.svg              annex.largefiles=exclude=*.important.*
*.ico              annex.largefiles=exclude=*.important.*
# Audio / video
*.mp4              annex.largefiles=anything
*.mov              annex.largefiles=anything
*.webm             annex.largefiles=anything
*.avi              annex.largefiles=anything

