{
  "name": "obsidian-annex-gallery",
  "version": "1.1.1",
  "description": "Obsidian plugin: git + git-annex backed image gallery (thumbnails + sidecar md + .base)",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "node tests/test-annex-functions.cjs",
    "verify:annex": "node tools/verify-annex-ops.cjs",
    "verify:sidecar": "node tools/verify-sidecar-overwrite.cjs",
    "verify:gallery": "node tools/verify-gallery.cjs",
    "verify:init": "node tools/verify-init.cjs",
    "smoke": "node tools/smoke-test.cjs",
    "remotes": "node tools/remotes-check.cjs",
    "verify:status": "node tools/status-check.cjs",
    "gui:status": "python3 tools/status-gui-check.py",
    "layout": "node tools/layout-check.cjs",
    "gui": "python3 tools/real-gui-check.py",
    "cli": "node tools/annex-gallery.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "obsidian": "^1.7.2",
    "typescript": "^5.7.2",
    "yaml": "^2.9.1"
  }
}
