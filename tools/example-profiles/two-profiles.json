[
  {
    "id": "tecnaitem",
    "name": "TECNAI 电镜（<放大倍数>X-<标记>-<序号>）",
    "source": "stem",
    "regex": "^(?<magnification>\\d+)X-(?<marker>.+)-(?<index>\\d+)$",
    "fields": [
      {
        "group": "magnification",
        "type": "number"
      },
      {
        "group": "marker",
        "type": "string"
      },
      {
        "group": "index",
        "type": "number"
      }
    ],
    "constFields": {
      "eagleId": ""
    },
    "ask": [
      "sample"
    ],
    "keyOrder": [
      "tags",
      "sample",
      "session",
      "date",
      "magnification",
      "index",
      "width",
      "height",
      "size",
      "btime",
      "thumbnail",
      "tif"
    ],
    "onMismatch": "empty",
    "match": {
      "relpathRegex": "\\d+X-[0-9A-Za-z]+-\\d+\\.(?:tif|tiff|png|jpg|jpeg|bmp|webp)$",
      "filenameRegex": "^\\d+X-[0-9A-Za-z]+-\\d+"
    }
  },
  {
    "id": "platewell",
    "name": "多孔板成像（plate01_wellA3_4000x_007）",
    "match": {
      "relpathRegex": "plate\\d+(?:_well[A-Z]\\d+)?_\\d+x_\\d+\\.(?:png|tif|tiff|jpg|jpeg|bmp|webp)$",
      "filenameRegex": "^plate\\d+(?:_well[A-Z]\\d+)?_\\d+x_\\d+"
    },
    "source": "stem",
    "regex": "^plate(?<plate>\\d+)(?:_well(?<well>[A-Z]\\d+))?_(?<magnification>\\d+)x_(?<index>\\d+)$",
    "fields": [
      {
        "group": "plate",
        "type": "number"
      },
      {
        "group": "well",
        "type": "text",
        "whenMissing": ""
      },
      {
        "group": "magnification",
        "type": "number"
      },
      {
        "group": "index",
        "type": "number"
      }
    ],
    "constFields": {
      "instrument": "plate-reader"
    },
    "ask": [
      "sample"
    ],
    "keyOrder": [
      "tags",
      "sample",
      "session",
      "date",
      "plate",
      "well",
      "magnification",
      "index",
      "instrument",
      "notes",
      "width",
      "height",
      "size",
      "btime",
      "thumbnail",
      "tif"
    ],
    "onMismatch": "empty"
  }
]
